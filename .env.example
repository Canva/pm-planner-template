# Copy to .env (scripts/setup.sh does this for you automatically).
# Never commit your real .env — it will contain secrets specific to your team's instance.

# Local dev database (SQLite). Do not reuse this across different teams' instances.
DATABASE_URL="file:./prisma/dev.db"

# Auto-generated per instance by scripts/setup.sh — leave blank here.
NEXTAUTH_SECRET=

# Public URL reviewers/your team use to reach this instance.
# Update this once your Infra Highway tunnel URL is known.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional integrations — can also be set later via Admin > Settings in the app itself.
MONDAY_API_TOKEN=
SLACK_BOT_TOKEN=
